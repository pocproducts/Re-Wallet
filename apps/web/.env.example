# ── Privy ──────────────────────────────────────────────────────────────────────
# El app id va al navegador: es público por diseño. La seguridad del app id no
# está en ocultarlo, sino en los **dominios permitidos** del panel de Privy.
# En local no hacen falta. En producción sí.
VITE_PRIVY_APP_ID=""

# ── Backend ───────────────────────────────────────────────────────────────────
# En local: el backend en su puerto. En producción: https://app.rewallet.win/api
VITE_API_BASE_URL="http://localhost:8787"
