# ─── Core ───────────────────────────────────────────────
DATABASE_URL=postgres://bestpath:bestpath@localhost:5432/bestpath
NODE_ENV=development
PORT=3000

# ─── Auth (Privy) ───────────────────────────────────────
PRIVY_APP_ID=
PRIVY_VERIFICATION_JWKS=https://auth.privy.io/api/v1/apps/<app-id>/jwks.json
PRIVY_APP_SECRET=

# ─── Chain (Monad EVM L1) ───────────────────────────────
# 143 = mainnet, 10143 = testnet. Required, no default.
MONAD_CHAIN_ID=
MONAD_RPC_URL=
MONAD_EXPLORER_URL=

# ─── Account Abstraction (gas sponsorship) ──────────────
GAS_PHASE=mvp
GAS_TESTNET_MODE=true
PIMLICO_API_KEY=
PIMLICO_BUNDLER_URL=
PIMLICO_PAYMASTER_URL=

# ─── Yield (Aave V3 on Monad) ───────────────────────────
USDC_ADDRESS_MONAD=
AAVE_POOL_ADDRESS_MONAD=
AAVE_ATOKEN_ADDRESS_MONAD=

# ─── Session ───────────────────────────────────────────
# 64 hex chars. Generate: openssl rand -hex 32
SESSION_SECRET=
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ─── Webhooks ──────────────────────────────────────────
WEBHOOK_SECRET_PRIVY=
WEBHOOK_SECRET_PIMLICO=

# ─── Rate limiting ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Logging ───────────────────────────────────────────
LOG_LEVEL=info
