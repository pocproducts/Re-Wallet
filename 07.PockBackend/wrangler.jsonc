{
  // One Worker for everything: the API and the web app, on the SAME origin.
  //
  // This is a security decision, not a convenience. The session is an httpOnly
  // `SameSite=Lax` cookie with a `__Host-` prefix. With two origins that cookie
  // has to become cross-site (`SameSite=None` plus credentialed CORS), which is
  // exactly the pair of security changes that single-origin avoids. The
  // `__Host-` prefix also forces `Secure`, no `Domain`, and `Path=/`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rewallet-poc-api",
  "main": "dist-worker.js",
  "compatibility_date": "2026-10-02",

  // `nodejs_compat` is what makes `node:crypto` and `process.env` exist in the
  // Workers runtime. Without it neither the session signing nor reading the
  // bindings works.
  "compatibility_flags": ["nodejs_compat"],

  // The front end. The same Worker serves it, so there is only one origin.
  //
  // The path is relative to THIS file, which lives in `apps/api/`. That makes
  // `apps/web` one level up, and nothing to do with the old folder names:
  // `"../05. UI-UX/dist"` stopped resolving the day the repo was reorganised,
  // and Wrangler does not fail on a missing directory here — it deploys a
  // Worker that answers `/api/*` and 404s everything else. A deployment that
  // looks green and serves nothing is worse than one that fails.
  "assets": {
    "directory": "../05. UI-UX/dist",
    "not_found_handling": "single-page-application"
  },

  // Secrets are NOT in this file. They are set with `wrangler secret put`:
  // PRIVY_APP_ID, PRIVY_APP_SECRET, DATABASE_URL, SESSION_SECRET.
  //
  // DOS dominios, un solo Worker. `app` es el de marca y `beta` sigue existiendo
  // como la misma app, no como una versión distinta: los dos apuntan acá, así que
  // ninguno rompe el otro y probar en cualquiera de los dos es probar lo mismo.
  //
  // Lo que NO puede volver a pasar es que OTRO Worker tome `app.rewallet.win`.
  // Pasó una vez: `rewallet-app-dev` —creado desde el `wrangler.jsonc` del front,
  // que dice en mayúsculas que no se despliegue desde ahí— se adjudicó la ruta, y
  // el síntoma fue `/api/auth/session` devolviendo 404 en vez de 401: el front
  // servía y el login no podía funcionar nunca.
  //
  // La cookie de sesión es `httpOnly`, `SameSite=Lax` y con prefijo `__Host-`.
  // Ese prefijo obliga a `Secure`, sin `Domain` y `Path=/`, y `SameSite=Lax`
  // exige que el front y la API sean el mismo sitio. Con dos Workers
  // compitiendo por el dominio, uno gana y el otro sirve sin API.
  "routes": [
    { "pattern": "app.rewallet.win", "custom_domain": true },
    { "pattern": "beta.rewallet.win", "custom_domain": true }
  ],

  "observability": { "enabled": false },

  // Los RPC de Alchemy NO viven acá.
  //
  // Estaban en `vars` con la API key en texto plano, y por lo tanto en el
  // historial de git. Un `vars` es un binding público del worker: lo que
  // estaba acá era una credencial escrita en un archivo versionado, que es
  // exactamente el modo de falla que una billeteria no puede tener.
  //
  // Ahora son secrets (`wrangler secret put`), que se guardan cifrados y no
  // viajan ni al repo ni al bundle. Con_vars_ el mismo nombre, wrangler
  // rechaza el secret porque el binding ya existe: por eso la conversion
  // requiere desplegar una version sin ellos primero.
  //
  // MONAD_POOL_RPC_URL sigue siendo var porque no tiene credencial: es el
  // endpoint publico de Monad.
  "vars": {
    "MONAD_POOL_RPC_URL": "https://rpc.monad.xyz"
  }
}